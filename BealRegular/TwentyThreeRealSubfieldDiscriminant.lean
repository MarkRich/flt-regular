    module

private lemma res6_5 :
    p6.resultant p5 = (-35 / 36 : ℚ) ^ 5 * p5.resultant p4 := by
  apply resultant_step (n := 5) (q := X - C (1 / 42))
  · norm_num
  · simp only [p6]
    compute_degree!
  · simp only [p5]
    compute_degree!
  · simp only [p4]
    compute_degree!
