private lemma res5_4 :
    p5.resultant p4 = (-24 / 25 : ℚ) ^ 4 * p4.resultant p3 := by
  apply resultant_step (n := 4) (q := X - C (1 / 30))
  · norm_num
  · simp only [p5]
    compute_degree!
  · simp only [p4]
    compute_degree!
