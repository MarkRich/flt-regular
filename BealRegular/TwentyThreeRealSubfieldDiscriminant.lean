module

public import BealRegular.TwentyThreeRealSubfieldPowerBasis

/-!
# The discriminant and maximal order of the real subfield at 23

An explicit Euclidean resultant chain computes the discriminant of the
degree-eleven real-subfield polynomial as `23^10`.  Combining this with the
power basis generated by `alpha` and the 23-Eisenstein translate `beta`
proves that `ℤ[beta]` is the full integral closure.
-/

@[expose] public section

namespace BealRegular.TwentyThreeRealSubfieldDiscriminant

open BealRegular.TwentyThreeRealSubfield
open BealRegular.TwentyThreeRealSubfieldEisenstein
open BealRegular.TwentyThreeRealSubfieldPowerBasis
open Polynomial

noncomputable section

local notation "K23" => CyclotomicField 23 ℚ
local notation "K23plus" => NumberField.maximalRealSubfield K23

private lemma mul_C_eq_smul (p : ℚ[X]) (a : ℚ) :
    p * C a = a • p := by
  rw [mul_comm]
  exact (Polynomial.qsmul_eq_C_mul a p).symm

private lemma C_mul_eq_smul (p : ℚ[X]) (a : ℚ) :
    C a * p = a • p :=
  (Polynomial.qsmul_eq_C_mul a p).symm

private lemma C_eq_smul_one (a : ℚ) :
    C a = a • (1 : ℚ[X]) := by
  rw [← Polynomial.C_1, Polynomial.smul_C]
  simp

/-- One step of the normalized polynomial remainder sequence used below. -/
private lemma resultant_step
    {f g h q : ℚ[X]} {n : ℕ} {c : ℚ}
    (hn : 0 < n)
    (hf : f.natDegree = n + 1)
    (hg : g.natDegree = n)
    (hh : h.natDegree = n - 1)
    (hgm : g.Monic)
    (hc : c ≠ 0)
    (hq : q.natDegree ≤ 1)
    (heq : f = C c * h + g * q) :
    f.resultant g = c ^ n * g.resultant h := by
  have hch : (C c * h).natDegree = n - 1 := by
    rw [natDegree_C_mul hc, hh]
  have hqdeg : q.natDegree + n ≤ n + 1 := by omega
  rw [show f.resultant g = f.resultant g (n + 1) n by simp [hf, hg]]
  rw [heq]
  rw [resultant_add_mul_left _ _ _ _ _ hqdeg (by simp [hg])]
  rw [show n + 1 = (n - 1) + 2 by omega]
  rw [resultant_add_left_deg (C c * h) g (n - 1) n 2 hch.le]
  rw [show g.coeff n = 1 by rw [← hg, hgm.coeff_natDegree]]
  simp only [one_pow, mul_one]
  rw [resultant_comm]
  rw [resultant_C_mul_right]
  simp only [hg, hh]
  have heven1 : Even (n * 2) := ⟨n, by omega⟩
  have heven2 : Even ((n - 1) * n) := by
    simpa [mul_comm] using Nat.even_mul_pred_self n
  rw [heven1.neg_one_pow, heven2.neg_one_pow]
  simp

private def p11 : ℚ[X] :=
  X ^ 11 + C (-1) * X ^ 10 + C (-10) * X ^ 9 + C 9 * X ^ 8 +
    C 36 * X ^ 7 + C (-28) * X ^ 6 + C (-56) * X ^ 5 + C 35 * X ^ 4 +
      C 35 * X ^ 3 + C (-15) * X ^ 2 + C (-6) * X + C 1

private def p10 : ℚ[X] :=
  X ^ 10 + C (-10 / 11) * X ^ 9 + C (-90 / 11) * X ^ 8 +
    C (72 / 11) * X ^ 7 + C (252 / 11) * X ^ 6 + C (-168 / 11) * X ^ 5 +
      C (-280 / 11) * X ^ 4 + C (140 / 11) * X ^ 3 + C (105 / 11) * X ^ 2 +
        C (-30 / 11) * X + C (-6 / 11)

private def p9 : ℚ[X] :=
  X ^ 9 + C (-9 / 10) * X ^ 8 + C (-36 / 5) * X ^ 7 +
    C (28 / 5) * X ^ 6 + C (84 / 5) * X ^ 5 + C (-21 / 2) * X ^ 4 +
      C (-14) * X ^ 3 + C 6 * X ^ 2 + C 3 * X + C (-1 / 2)

private def p8 : ℚ[X] :=
  X ^ 8 + C (-8 / 9) * X ^ 7 + C (-56 / 9) * X ^ 6 +
    C (14 / 3) * X ^ 5 + C (35 / 3) * X ^ 4 + C (-20 / 3) * X ^ 3 +
      C (-20 / 3) * X ^ 2 + C (20 / 9) * X + C (5 / 9)

private def p7 : ℚ[X] :=
  X ^ 7 + C (-7 / 8) * X ^ 6 + C (-21 / 4) * X ^ 5 +
    C (15 / 4) * X ^ 4 + C (15 / 2) * X ^ 3 + C (-15 / 4) * X ^ 2 +
      C (-5 / 2) * X + C (1 / 2)

private def p6 : ℚ[X] :=
  X ^ 6 + C (-6 / 7) * X ^ 5 + C (-30 / 7) * X ^ 4 +
    C (20 / 7) * X ^ 3 + C (30 / 7) * X ^ 2 + C (-12 / 7) * X + C (-4 / 7)

private def p5 : ℚ[X] :=
  X ^ 5 + C (-5 / 6) * X ^ 4 + C (-10 / 3) * X ^ 3 +
    C 2 * X ^ 2 + C 2 * X + C (-1 / 2)

private def p4 : ℚ[X] :=
  X ^ 4 + C (-4 / 5) * X ^ 3 + C (-12 / 5) * X ^ 2 +
    C (6 / 5) * X + C (3 / 5)

private def p3 : ℚ[X] :=
  X ^ 3 + C (-3 / 4) * X ^ 2 + C (-3 / 2) * X + C (1 / 2)

private def p2 : ℚ[X] :=
  X ^ 2 + C (-2 / 3) * X + C (-2 / 3)

private def p1 : ℚ[X] := X + C (-1 / 2)

private def p0 : ℚ[X] := 1

private lemma res11_10 :
    p11.resultant p10 = (-230 / 121 : ℚ) ^ 10 * p10.resultant p9 := by
  apply resultant_step (n := 10) (q := X - C (1 / 11))
  · norm_num
  · simp only [p11]
    compute_degree!
  · simp only [p10]
    compute_degree!
  · simp only [p9]
    compute_degree!
  · simp only [p10]
    monicity!
  · norm_num
  · compute_degree!
  · simp [p11, p10, p9]
    ring_nf
    simp only [mul_C_eq_smul]
    simp only [C_eq_smul_one]
    module

private lemma res10_9 :
    p10.resultant p9 = (-99 / 100 : ℚ) ^ 9 * p9.resultant p8 := by
  apply resultant_step (n := 9) (q := X - C (1 / 110))
  · norm_num
  · simp only [p10]
    compute_degree!
  · simp only [p9]
    compute_degree!
  · simp only [p8]
    compute_degree!
  · simp only [p9]
    monicity!
  · norm_num
  · compute_degree!
  · simp [p10, p9, p8]
    ring_nf
    simp only [mul_C_eq_smul]
    simp only [C_eq_smul_one]
    module

private lemma res9_8 :
    p9.resultant p8 = (-80 / 81 : ℚ) ^ 8 * p8.resultant p7 := by
  apply resultant_step (n := 8) (q := X - C (1 / 90))
