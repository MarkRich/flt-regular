    simp only [C_eq_smul_one]
    module

private lemma res8_7 :
    p8.resultant p7 = (-63 / 64 : ℚ) ^ 7 * p7.resultant p6 := by
  apply resultant_step (n := 7) (q := X - C (1 / 72))
  · norm_num
  · simp only [p8]
