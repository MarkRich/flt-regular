private lemma resultant_p11_p10 :
    p11.resultant p10 = -(23 : ℚ) ^ 10 / 11 ^ 11 := by
  rw [res11_10, res10_9, res9_8, res8_7, res7_6, res6_5, res5_4,
    res4_3, res3_2, res2_1]
  norm_num [p0]

private lemma p11_eq_realSubfieldPolynomialRat :
    p11 = realSubfieldPolynomialRat := by
  simp [p11, realSubfieldPolynomialRat, realSubfieldPolynomial]
  ring_nf
  simp only [Polynomial.C_ofNat]

private lemma p11_natDegree : p11.natDegree = 11 := by
  simp only [p11]
  compute_degree!

private lemma p10_natDegree : p10.natDegree = 10 := by
  simp only [p10]
  compute_degree!

private lemma p11_monic : p11.Monic := by
  simp only [p11]
  monicity!

private lemma derivative_p11 : p11.derivative = C 11 * p10 := by
  simp [p11, p10]
  ring_nf
  simp only [← Polynomial.C_ofNat]
  simp only [mul_C_eq_smul]
  simp only [C_mul_eq_smul]
  simp only [C_eq_smul_one]
  module

private lemma resultant_p11_derivative :
    p11.resultant p11.derivative = -(23 : ℚ) ^ 10 := by
  rw [derivative_p11]
  rw [show (C (11 : ℚ) * p10).natDegree = 10 by
    rw [natDegree_C_mul (by norm_num), p10_natDegree]]
  rw [resultant_C_mul_right]
  rw [p11_natDegree]
  rw [show p11.resultant p10 11 10 = p11.resultant p10 by
    rw [p11_natDegree, p10_natDegree]]
  rw [resultant_p11_p10]
  norm_num

private lemma discr_p11 : p11.discr = (23 : ℚ) ^ 10 := by
  have hr := Polynomial.resultant_deriv (f := p11) (by
    rw [← natDegree_pos_iff_degree_pos, p11_natDegree]
    norm_num)
  have hderiv : p11.derivative.natDegree = 10 := by
    rw [derivative_p11, natDegree_C_mul (by norm_num), p10_natDegree]
  have hr' : p11.resultant p11.derivative = -p11.discr := by
    rw [show p11.resultant p11.derivative =
        p11.resultant p11.derivative p11.natDegree (p11.natDegree - 1) by
      rw [hderiv, p11_natDegree]]
    rw [hr, p11_natDegree, p11_monic.leadingCoeff]
    norm_num
  have h := resultant_p11_derivative
  rw [hr'] at h
  linarith

/-- The explicit rational real-subfield polynomial has discriminant `23^10`. -/
theorem realSubfieldPolynomialRat_discr :
    realSubfieldPolynomialRat.discr = (23 : ℚ) ^ 10 := by
  rw [← p11_eq_realSubfieldPolynomialRat]
  exact discr_p11

private lemma realSubfieldPolynomial_derivative_natDegree :
    realSubfieldPolynomial.derivative.natDegree = 10 := by
  rw [Polynomial.natDegree_derivative,
    realSubfieldPolynomial_natDegree]

private lemma resultant_realSubfieldPolynomial_derivative :
    realSubfieldPolynomial.resultant realSubfieldPolynomial.derivative =
      -(23 : ℤ) ^ 10 := by
  apply_fun (Int.castRingHom ℚ) using Int.cast_injective
  rw [← Polynomial.resultant_map_map]
  rw [← Polynomial.derivative_map]
  rw [realSubfieldPolynomial_natDegree,
    realSubfieldPolynomial_derivative_natDegree]
  change realSubfieldPolynomialRat.resultant
    realSubfieldPolynomialRat.derivative 11 10 =
      (Int.castRingHom ℚ) (-(23 : ℤ) ^ 10)
  rw [← p11_eq_realSubfieldPolynomialRat]
  rw [show p11.resultant p11.derivative 11 10 =
      p11.resultant p11.derivative by
    rw [p11_natDegree]
    rw [show p11.derivative.natDegree = 10 by
      rw [derivative_p11, natDegree_C_mul (by norm_num),
        p10_natDegree]]]
  rw [resultant_p11_derivative]
  norm_num

/-- The integral real-subfield polynomial has discriminant `23^10`. -/
theorem realSubfieldPolynomial_discr :
    realSubfieldPolynomial.discr = (23 : ℤ) ^ 10 := by
  have hr := Polynomial.resultant_deriv (f := realSubfieldPolynomial) (by
    rw [← natDegree_pos_iff_degree_pos,
      realSubfieldPolynomial_natDegree]
    norm_num)
  have hr' : realSubfieldPolynomial.resultant
      realSubfieldPolynomial.derivative =
      -realSubfieldPolynomial.discr := by
    rw [show realSubfieldPolynomial.resultant
        realSubfieldPolynomial.derivative =
        realSubfieldPolynomial.resultant
          realSubfieldPolynomial.derivative
          realSubfieldPolynomial.natDegree
          (realSubfieldPolynomial.natDegree - 1) by
      rw [realSubfieldPolynomial_derivative_natDegree,
        realSubfieldPolynomial_natDegree]]
    rw [hr, realSubfieldPolynomial_natDegree,
      realSubfieldPolynomial_monic.leadingCoeff]
    norm_num
  have h := resultant_realSubfieldPolynomial_derivative
  rw [hr'] at h
  linarith

/-- The explicit `alpha` power basis has discriminant `23^10`. -/
theorem alphaPowerBasis_discr :
    Algebra.discr ℚ alphaPowerBasis.basis = (23 : ℚ) ^ 10 := by
  rw [alphaPowerBasis_discr_eq_polynomial_discr]
  exact realSubfieldPolynomialRat_discr

/-- Translation by two does not change the integral order generated by the
real-subfield generator. -/
theorem adjoin_int_alpha_eq_adjoin_beta :
    Algebra.adjoin ℤ ({alpha} : Set K23plus) =
      Algebra.adjoin ℤ ({beta} : Set K23plus) := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    intro x hx
    simp only [Set.mem_singleton_iff] at hx
    subst x
    rw [show alpha = beta - algebraMap ℤ K23plus 2 by
      simp [beta]]
    exact Subalgebra.sub_mem _ (Algebra.subset_adjoin (Set.mem_singleton beta))
      (Subalgebra.algebraMap_mem _ 2)
  · apply Algebra.adjoin_le
    intro x hx
    simp only [Set.mem_singleton_iff] at hx
    subst x
    rw [show beta = alpha + algebraMap ℤ K23plus 2 by
      simp [beta]]
    exact Subalgebra.add_mem _ (Algebra.subset_adjoin (Set.mem_singleton alpha))
      (Subalgebra.algebraMap_mem _ 2)

/-- The order generated by the 23-Eisenstein translate `beta` is the full
integral closure of `ℤ` in the maximal real subfield. -/
theorem isIntegralClosure_adjoin_beta :
    IsIntegralClosure (Algebra.adjoin ℤ ({beta} : Set K23plus)) ℤ
      K23plus := by
  refine ⟨Subtype.val_injective,
    @fun x => ⟨fun h => ⟨⟨x, ?_⟩, rfl⟩, ?_⟩⟩
  swap
  · rintro ⟨y, rfl⟩
    exact IsIntegral.algebraMap
      ((le_integralClosure_iff_isIntegral.1
        (adjoin_le_integralClosure beta_isIntegral_int)).isIntegral y)
  · have hintAlpha : IsIntegral ℤ alphaPowerBasis.gen := by
      rw [alphaPowerBasis_gen]
      exact alpha_isIntegral_int
    have H := Algebra.discr_mul_isIntegral_mem_adjoin ℚ hintAlpha h
    rw [alphaPowerBasis_discr] at H
    have Halpha :
        (23 : ℤ) ^ 10 • x ∈
          Algebra.adjoin ℤ ({alpha} : Set K23plus) := by
      rw [← smul_pow_twentyThree, ← alphaPowerBasis_gen]
      exact H
    have Hbeta :
        (23 : ℤ) ^ 10 • x ∈
          Algebra.adjoin ℤ ({betaPowerBasis.gen} : Set K23plus) := by
      rw [betaPowerBasis_gen, ← adjoin_int_alpha_eq_adjoin_beta]
      exact Halpha
    have hintBeta : IsIntegral ℤ betaPowerBasis.gen := by
      rw [betaPowerBasis_gen]
      exact beta_isIntegral_int
    have hmin :
        (minpoly ℤ betaPowerBasis.gen).IsEisensteinAt
          (Submodule.span ℤ {(23 : ℤ)}) := by
      rw [betaPowerBasis_gen,
        minpoly_int_beta_eq_shiftedRealSubfieldPolynomial]
      exact shiftedRealSubfieldPolynomial_isEisensteinAt
    simpa only [betaPowerBasis_gen] using
      (mem_adjoin_of_smul_prime_pow_smul_of_minpoly_isEisensteinAt
        (p := (23 : ℤ)) (n := 10)
        (Nat.prime_iff_prime_int.1
          BealRegular.TwentyThreePrimeTwoCube.prime_twentyThree)
        hintBeta h Hbeta hmin)

end

end BealRegular.TwentyThreeRealSubfieldDiscriminant
